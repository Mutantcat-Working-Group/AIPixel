{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIPixel",
  "version": "1.0.20261009",
  "identifier": "com.aipixel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIPixel",
        "width": 1320,
        "height": 880,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage", "deb"],
    "category": "DeveloperTool",
    "publisher": "Mutantcat Working Group (mutantcat.org)",
    "copyright": "© 2026 异猫工作群 (mutantcat.org)",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Pixel art agent workspace",
    "longDescription": "AIPixel is an open-source pixel art agent workspace. It drives a user-provided LLM through sandboxed Lua shaders and typed pixel operations; the canvas text grid is the only authoritative state.",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "template": "nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
