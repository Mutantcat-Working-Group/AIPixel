# 本仓库是 Tauri 桌面工程：根目录是 Rust workspace + React 前端。
# example/ 里保留了最初那套 Pillow 工具链与样例数据，被 README 引用，
# 属于交付内容，不在此文件忽略范围内；新增产物目录时请显式加白，而不是靠这里兜底。

# ---------- Python（example/ 遗留工具链） ----------
__pycache__/
*.py[cod]
*.egg
*.egg-info/

# setuptools 输出；锚定根目录，避免误伤嵌套的 build 目录
/build/

# example/ 里 python -m build 的产物
/example/build/
/example/dist/

# release workflow 的暂存目录：wheel、源码包、校验和都往这里落
/release/

.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---------- Node / 前端 ----------
node_modules/

# vite 构建产物，同时是 Tauri 的 frontendDist 指向的位置
/dist/

*.tsbuildinfo
.vite/
*.local
.env
.env.local
.env.*.local
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.eslintcache
/coverage/

# ---------- Rust / Tauri ----------

# cargo 工作空间产物；src-tauri 若脱离 workspace 单独构建，也会落在 src-tauri/target
target/

*.rs.bk
*.pdb

# Tauri 各平台打包产物
*.app
*.dmg
*.msi
*.exe
*.deb
*.rpm
*.AppImage

# ---------- 系统与编辑器 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 本地工具输出 ----------
.playwright-cli/
